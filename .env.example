# ---------- Supabase (obrigatório para contas reais) ----------
# Sem estas duas variáveis o app abre em "Modo demonstração" (dados só no aparelho).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor (Vercel > Environment Variables). Usada apenas para excluir a conta.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Análise de foto por IA (opcional, tem custo por uso) ----------
# Provedores suportados: anthropic | openai
AI_VISION_PROVIDER=anthropic
AI_VISION_API_KEY=
# Modelo com visão. Ex.: claude-sonnet-5-5 (Anthropic) ou gpt-4.1-mini (OpenAI)
AI_VISION_MODEL=claude-sonnet-5-5

# ---------- Base nutricional complementar (opcional, gratuita com chave) ----------
# USDA FoodData Central (domínio público / CC0). https://fdc.nal.usda.gov/api-key-signup
USDA_FDC_API_KEY=

# ---------- Manutenção (Vercel Cron) ----------
# Segredo aleatório longo; a Vercel envia automaticamente como Bearer para rotas de cron.
CRON_SECRET=

# ---------- Assinaturas (Mercado Pago) ----------
# Painel: mercadopago.com.br/developers → Suas integrações → Credenciais de produção
MERCADOPAGO_ACCESS_TOKEN=
# Painel → Webhooks → "Assinatura secreta" (URL: https://SEU-APP/api/pagamentos/webhook)
MERCADOPAGO_WEBHOOK_SECRET=
# Endereço público do app (usado nos links de retorno do pagamento)
NEXT_PUBLIC_APP_URL=https://leveza-one.vercel.app
